pe=\"device_forever\" x=\"205\" y=\"0\"></block></xml>","main.ts":"let leftSpeed = 0\nlet rightSpeed = 0\nlet isTurningLeft = false\nlet isTurningRight = false\nlet baseSpeed = 20\nlet baseCorrection = 10\nlet correction = 0\nlet correctionStep = 5\nlet minimumSpeed = 10\nlet maximumSpeed = 50\n\n\nfunction turnLeft(){\n    correction = (correction < 0)?baseCorrection:correction + correctionStep\n    neZha.setMotorSpeed(neZha.MotorList.M4, baseSpeed+correction)\n    neZha.setMotorSpeed(neZha.MotorList.M1, baseSpeed-correction)\n}\n\nfunction turnRight(){\n    correction = (correction > 0) ? - baseCorrection : correction - correctionStep\n    neZha.setMotorSpeed(neZha.MotorList.M4, baseSpeed + correction)\n    neZha.setMotorSpeed(neZha.MotorList.M1, MathbaseSpeed - correction)\n}\n\n\n\nbasic.forever(function () {\n    if (PlanetX_Basic.trackingSensor(PlanetX_Basic.DigitalRJPin.J1, PlanetX_Basic.TrackingStateType.Tracking_State_1)) {\n        turnLeft()\n    }\n    if (PlanetX_Basic.trackingSensor(PlanetX_Basic.DigitalRJPin.J1, PlanetX_Basic.TrackingStateType.Tracking_State_2)) {\n        turnRight()\n    }\n    if (PlanetX_Basic.trackingSensor(PlanetX_Basic.DigitalRJPin.J1, PlanetX_Basic.TrackingStateType.Tracking_State_0)) {\n        neZha.setMotorSpeed(neZha.MotorList.M1, 20)\n        neZha.setMotorSpeed(neZha.MotorList.M4, 20)\n        correction = 0\n    }\n})\n","README.md":"","pxt.json":"{\n    \"name\": \"nezah algo\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"pxt-nezha\": \"github:elecfreaks/pxt-nezha#v1.3.10\",\n        \"pxt-PlanetX\": \"github:elecfreaks/pxt-planetx#v1.6.2\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}}],"shares":[],"lastSaveTime":1775899763271}